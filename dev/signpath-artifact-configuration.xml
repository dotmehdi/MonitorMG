<?xml version="1.0" encoding="utf-8" ?>
<!-- Configuration d'artefact SignPath pour MonitorMG (voir docs/SIGNATURE.md).
     Décrit l'artefact « a-signer » téléversé par .github/workflows/release.yml :
     un zip (artefact GitHub Actions) contenant les deux exécutables téléchargés
     par les utilisateurs. À coller dans le projet SignPath (Artifact configuration)
     et à valider dans leur éditeur, qui fait autorité sur le schéma. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="setup.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="MonitorMG.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
